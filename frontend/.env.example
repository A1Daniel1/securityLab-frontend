# Copy this file and fill in the real values (do not commit the copy).
#
#   .env.local        -> local development (git-ignored)
#   .env.production   -> production build  (git-ignored)
#
# For a production build, VITE_API_URL must point to the public address:
#   https://danielenterpriseapplication.duckdns.org

VITE_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://enterprise-risk-api
VITE_API_URL=http://localhost:8080
